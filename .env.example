# Variables de entorno de AgroIA-Web. Copia este archivo como .env en la raíz:
#     Copy-Item .env.example .env
# y cambia los valores. Nunca subas .env al repositorio.
# docker-compose.yml lee este .env y le pasa a cada servicio solo lo que necesita.

# ---------------------------------------------------------------------------
# Django (web, svc-usuarios, svc-tienda, svc-contenido)
# ---------------------------------------------------------------------------
# Genera una propia con:  py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,svc-usuarios,svc-tienda,svc-contenido

# ---------------------------------------------------------------------------
# Autenticación (todos los servicios)
# ---------------------------------------------------------------------------
# En el código vale True por defecto. Solo el .env local puede ponerla en False
# durante el desarrollo inicial; para la entrega debe estar en True.
AUTH_ACTIVA=True

# Rutas DENTRO de los contenedores. Las llaves se generan en infra/llaves/ con
# infra/generar_llaves.py y docker-compose.yml las monta en /run/secrets/.
# La privada solo llega a svc-usuarios; la pública, a todos.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_privada.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_publica.pem

# ---------------------------------------------------------------------------
# PostgreSQL (web, svc-usuarios, svc-tienda)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Superusuario del contenedor postgres (solo lo usa infra/postgres/init.sql).
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-cambiar
# Cada servicio tiene su propia base y su propio usuario:
#   usuarios_db / usuarios, tienda_db / tienda, web_db / web
# Si cambias estas contraseñas después de crear el volumen, ver README.md.
USUARIOS_DB_PASSWORD=usuarios-dev-cambiar
TIENDA_DB_PASSWORD=tienda-dev-cambiar
WEB_DB_PASSWORD=web-dev-cambiar

# ---------------------------------------------------------------------------
# MongoDB (svc-contenido) y Redis (svc-usuarios, web)
# ---------------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017/contenido
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Servicios internos (web)
# ---------------------------------------------------------------------------
URL_SVC_USUARIOS=http://svc-usuarios:8000
URL_SVC_TIENDA=http://svc-tienda:8000
URL_SVC_CONTENIDO=http://svc-contenido:8000
URL_SVC_IA=http://svc-ia:8000

# ---------------------------------------------------------------------------
# Correo (svc-usuarios)
# ---------------------------------------------------------------------------
# En local los correos se imprimen en la terminal (docker compose logs -f svc-usuarios).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="AgroIA <no-responder@agroia.local>"
# Base de los enlaces de los correos (apunta al gateway, no a la API).
FRONTEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM del agente (svc-ia) - mismas variables que el agente del repo AgroIA
# ---------------------------------------------------------------------------
# Clave de API de Groq -> https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
# Modelo por defecto del proyecto (no cambiar sin acordarlo).
LLM_MODEL=openai/gpt-oss-120b
