# Variables de entorno de AgroIA-Web. Copia este archivo como .env en la raíz:
#     Copy-Item .env.example .env
# y cambia los valores. Nunca subas .env al repositorio.
# docker-compose.yml lee este .env y le pasa a cada servicio solo lo que necesita.

# ---------------------------------------------------------------------------
# Django (web, svc-usuarios, svc-tienda, svc-contenido)
# ---------------------------------------------------------------------------
# Genera una propia con:  py -c "import secrets; print(secrets.token_urlsafe(50))"
# Con DJANGO_DEBUG=False los servicios no arrancan con este valor de ejemplo ni con una
# clave de menos de 50 caracteres.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
# True solo en desarrollo local. Para la demo y la entrega: DJANGO_DEBUG=False (entonces
# también hacen falta una DJANGO_SECRET_KEY propia y SMTP real en EMAIL_BACKEND).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,svc-usuarios,svc-tienda,svc-contenido

# ---------------------------------------------------------------------------
# Autenticación (todos los servicios)
# ---------------------------------------------------------------------------
# En el código vale True por defecto. Solo el .env local puede ponerla en False, y
# solo junto con DJANGO_DEBUG=True (si no, el servicio no arranca). Con False se
# apagan las revisiones de rol, pero los endpoints que necesitan saber quién es el
# usuario siguen pidiendo token: obtenlo con POST /api/v1/auth/login/ de svc-usuarios.
# Para la entrega debe estar en True.
AUTH_ACTIVA=True

# Rutas DENTRO de los contenedores. Las llaves se generan en infra/llaves/ con
# infra/generar_llaves.py y docker-compose.yml las monta en /run/secrets/.
# La privada solo llega a svc-usuarios; la pública, a todos.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_privada.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_publica.pem
# Emisor de los tokens (claim `iss`): svc-usuarios firma con él y los demás servicios
# rechazan cualquier otro. Si se cambia a ms-usuarios, sería `svc-usuarios`
# (ver docs/contrato-identidad.md).
JWT_ISSUER=agroia-usuarios

# ---------------------------------------------------------------------------
# PostgreSQL (web, svc-usuarios, svc-tienda)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Superusuario del contenedor postgres (solo lo usa infra/postgres/init.sql).
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-cambiar
# Cada servicio tiene su propia base y su propio usuario:
#   usuarios_db / usuarios, tienda_db / tienda, web_db / web
# Si cambias estas contraseñas después de crear el volumen, ver README.md.
USUARIOS_DB_PASSWORD=usuarios-dev-cambiar
TIENDA_DB_PASSWORD=tienda-dev-cambiar
WEB_DB_PASSWORD=web-dev-cambiar

# ---------------------------------------------------------------------------
# MongoDB (svc-contenido) y Redis
# ---------------------------------------------------------------------------
MONGO_URL=mongodb://mongo:27017/contenido
# Caché del límite de intentos (base 0; la usa svc-usuarios).
REDIS_URL=redis://redis:6379/0
# Eventos entre servicios con Redis Streams (base 1, separada de la caché). Ver
# docs/eventos.md. Reintentos de cada consumidor y espera base en segundos (crece al doble
# en cada intento: 2, 4, 8, 16, 32); al agotarlos, el evento va al stream de fallidos.
EVENTOS_REDIS_URL=redis://redis:6379/1
EVENTOS_MAX_REINTENTOS=5
EVENTOS_ESPERA_BASE=2

# ---------------------------------------------------------------------------
# Tienda (svc-tienda)
# ---------------------------------------------------------------------------
# Costo fijo de envío en pesos; gratis si el subtotal es MAYOR que ENVIO_GRATIS_DESDE.
COSTO_ENVIO=150.00
ENVIO_GRATIS_DESDE=1500.00

# ---------------------------------------------------------------------------
# Servicios internos (web)
# ---------------------------------------------------------------------------
URL_SVC_USUARIOS=http://svc-usuarios:8000
URL_SVC_TIENDA=http://svc-tienda:8000
URL_SVC_CONTENIDO=http://svc-contenido:8000
URL_SVC_IA=http://svc-ia:8000
# Segundos máximos de espera a un servicio; svc-ia aparte porque el agente tarda más.
SERVICIOS_TIMEOUT=10
IA_TIMEOUT=50
# Orígenes que pueden llamar al proxy /api/ desde un navegador, separados por coma y con
# esquema (por ejemplo, https://app.agroia.mx). Vacío: solo el propio gateway. Nunca "*".
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Correo (svc-usuarios)
# ---------------------------------------------------------------------------
# En local los correos se imprimen en la terminal (docker compose logs -f svc-usuarios).
# Con DJANGO_DEBUG=False svc-usuarios no arranca con la consola: usa
# django.core.mail.backends.smtp.EmailBackend y las variables EMAIL_* de abajo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Segundos que espera al servidor de correo el consumidor de correos (svc-usuarios-eventos).
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="AgroIA <no-responder@agroia.local>"
# Base de los enlaces de los correos (apunta al gateway, no a la API).
FRONTEND_URL=http://localhost:8000
# Versión vigente del aviso de privacidad; se guarda en cada usuario al registrarse.
VERSION_AVISO_PRIVACIDAD=2026-10

# ---------------------------------------------------------------------------
# svc-ia: adaptador del agente
# ---------------------------------------------------------------------------
# Dirección interna del contenedor agente y segundos máximos de espera por respuesta.
URL_AGENTE=http://agente:8000
AGENTE_TIMEOUT=45

# ---------------------------------------------------------------------------
# Contenedor agente (repo BryanGEP/AgroIA) - variables del LLM
# ---------------------------------------------------------------------------
# Cada integrante necesita su PROPIA llave gratuita de Groq:
#   https://console.groq.com/keys  (inicia sesión y crea una "API Key").
# Sin llave el sistema arranca, pero svc-ia responde 503 agente_no_disponible.
GROQ_API_KEY=
LLM_PROVIDER=groq
# Modelo por defecto del proyecto (no cambiar sin acordarlo).
LLM_MODEL=openai/gpt-oss-120b

# Base de conocimiento del agente (contenedor agente-db, PostgreSQL con pgvector).
# Contraseña de desarrollo: cámbiala. Solo se usa la primera vez que se crea su volumen.
AGENTE_DB_PASSWORD=agente-dev-cambiar
