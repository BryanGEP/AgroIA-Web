# El equipo trabaja en Windows, pero los contenedores son Linux: los scripts con
# CRLF fallan dentro de ellos. Estos archivos siempre se guardan con LF.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.ini       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
.env*       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.dockerignore   text eol=lf

*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
